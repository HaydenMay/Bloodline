{
  "name": "bloodline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Horse racing, training and breeding game. Browser + mobile web.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "tsx tools/harness.ts",
    "bake-sprites": "tsx tools/bake-sprites.ts",
    "ride-probe": "tsx tools/ride-probe.ts",
    "energy-profile": "tsx tools/energy-profile.ts",
    "margin-profile": "tsx tools/margin-profile.ts",
    "check": "npm run lint && npm run build && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.8.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
